class Point {
    let x: int32
    let y: int32
}

impl Point {
    func new(x: int32, y: int32): Self {
        return Point { x: x, y: y }
    }

    func add(self, other: Self): Self {
        return Point { x: self.x + other.x, y: self.y + other.y }
    }

    func get_x(self): int32 {
        return self.x
    }
}

external func main(): int32 {
    let p1: Point = Point::new(10, 20)
    let p2: Point = Point::new(5, 15)
    let p3: Point = p1.add(p2)

    if p1.get_x() != 10 {
        return 1
    }
    if p3.x != 15 {
        return 2
    }
    if p3.y != 35 {
        return 3
    }

    let p4: Point = p3.add(Point::new(-5, -5))
    if p4.x != 10 {
        return 4
    }
    if p4.y != 30 {
        return 5
    }

    return 0
}
