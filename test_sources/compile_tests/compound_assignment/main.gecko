declare external variardic func printf(format: string): int32

class Counter {
    let value: int32
}

external func main(): int32 {
    let x: int32 = 10
    let y: int32 = 5

    x += y
    printf("x after +=: %d\n", x)

    x -= 3
    printf("x after -=: %d\n", x)

    x *= 2
    printf("x after *=: %d\n", x)

    x /= 4
    printf("x after /=: %d\n", x)

    let c: Counter = Counter { value: 100 }
    c.value += 50
    printf("c.value after +=: %d\n", c.value)

    return x
}
