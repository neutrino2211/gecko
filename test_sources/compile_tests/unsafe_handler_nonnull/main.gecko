// spec: spec/types.md, spec/functions.md, spec/modules.md, spec/control-flow.md, spec/unsafe.md

package main

import std.unsafe use { NonNull }

external func main(): int32 {
    let x: int32 = 0
    let p: int32* = &x
    @unsafe with NonNull::handler(p as void*) {
        @write_volatile(p, 42)
    }
    return x
}
