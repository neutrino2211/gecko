package box

import std.core.traits use { Drop }
import std.option use { Option }
import std.unsafe use { NonNull }

public class Box<T> {
    let ptr: uint64

    func new(value: T): Box<T> {
        @unsafe [
            ptr: T* = @alloc(@size_of<T>(), @align_of<T>()) as T*
        ] with NonNull::handle(ptr as void*) {
            @deref(ptr) = @move(value)
            let b: Box<T>
            b.ptr = ptr as uint64
            return b
        }
    }

    @unsafe
    func from_raw(raw_ptr: uint64): Box<T> {
        let b: Box<T>
        b.ptr = raw_ptr
        return b
    }

    @unsafe
    func from_raw_checked(raw_ptr: uint64): Option<Box<T>> {
        if (raw_ptr == 0) { return Option<Box<T>>::none() }
        return Option<Box<T>>::some(Box<T>::from_raw(raw_ptr))
    }

    func is_valid(self): bool { return self.ptr != 0 }

    @unsafe
    func get(self): T {
        @unsafe { return @deref(self.ptr as T*) }
    }

    func into_inner(self): T {
        if (self.ptr == 0) { @unsafe { @trap() } }
        let address: uint64 = self.ptr
        self.ptr = 0
        @unsafe {
            let value: T = @deref(address as T*)
            @free(address as void*)
            return value
        }
    }

    func set(self, value: T): void {
        @unsafe {
            @drop_in_place(self.ptr as T*)
            @deref(self.ptr as T*) = @move(value)
        }
    }

    func as_raw(self): uint64 { return self.ptr }

    func into_raw(self): uint64 {
        let address: uint64 = self.ptr
        self.ptr = 0
        return address
    }

    func release(self): void {
        if (self.ptr == 0) { return }
        let address: uint64 = self.ptr
        self.ptr = 0
        @unsafe {
            @drop_in_place(address as T*)
            @free(address as void*)
        }
    }

    func drop(self): void { self.release() }
}

impl<T> Drop for Box<T> {
    func drop(self): void { self.release() }
}
