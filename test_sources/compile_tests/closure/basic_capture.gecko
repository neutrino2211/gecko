declare external variardic func printf(format: string): int32

func make_adder(): func(int32): int32 {
    let offset: int32 = 10
    return fn(x: int32): int32 {
        return x + offset
    }
}

external func main(): int32 {
    let adder: func(int32): int32 = make_adder()
    let result: int32 = adder(5)
    printf("Result: %d\n", result)
    return result
}
