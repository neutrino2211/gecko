// spec: spec/types.md, spec/functions.md, spec/modules.md, spec/control-flow.md

package main

foreign "c" sqlite {
    type sqlite3 opaque
    func sqlite3_open(filename: string, db: out sqlite3*): int32
}

external func main(): int32 {
    let db: sqlite3* = null
    let rc: int32 = sqlite.sqlite3_open(":memory:", out db)
    return rc
}
