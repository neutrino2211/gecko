// spec: spec/types.md, spec/functions.md, spec/modules.md, spec/control-flow.md, spec/unsafe.md

package main

@unsafe
func sneaky(): int32 {
    return 7
}

func main(): int32 {
    // Calling an @unsafe function requires an @unsafe region at the call site
    let v: int32 = sneaky()
    return v
}
