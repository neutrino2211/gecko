package weak

import std.core.traits use { Drop, Clone }
import std.memory.rc_storage use { RcInner }
import std.memory.rc use { Rc }
import std.option use { Option }

public class Weak<T> {
    let ptr: uint64

    @unsafe
    func from_rc_ptr(rc_ptr: uint64): Weak<T> {
        if (rc_ptr != 0) {
            @unsafe {
                let inner: RcInner<T>* = rc_ptr as RcInner<T>*
                inner.weak = inner.weak + 1
            }
        }
        let w: Weak<T>
        w.ptr = rc_ptr
        return w
    }

    func null(): Weak<T> {
        let w: Weak<T>
        w.ptr = 0
        return w
    }

    func is_valid(self): bool { return self.ptr != 0 }

    func strong_count(self): uint64 {
        if (self.ptr == 0) { return 0 }
        @unsafe {
            let inner: RcInner<T>* = self.ptr as RcInner<T>*
            return inner.strong
        }
    }

    func weak_count(self): uint64 {
        if (self.ptr == 0) { return 0 }
        @unsafe {
            let inner: RcInner<T>* = self.ptr as RcInner<T>*
            return inner.weak
        }
    }

    func is_alive(self): bool { return self.strong_count() > 0 }

    func upgrade(self): Option<Rc<T>> {
        @unsafe { return Rc<T>::from_inner_checked(self.ptr) }
    }

    @unsafe
    func try_get(self): T {
        if (self.ptr == 0 || self.strong_count() == 0) {
            let empty: T
            return empty
        }
        @unsafe {
            let inner: RcInner<T>* = self.ptr as RcInner<T>*
            return inner.value
        }
    }

    func clone(self): Weak<T> {
        @unsafe { return Weak<T>::from_rc_ptr(self.ptr) }
    }

    func release(self): void {
        if (self.ptr == 0) { return }
        let address: uint64 = self.ptr
        self.ptr = 0
        @unsafe {
            let inner: RcInner<T>* = address as RcInner<T>*
            inner.weak = inner.weak - 1
            if (inner.weak == 0 && inner.strong == 0) {
                @free(inner as void*)
            }
        }
    }

    func drop(self): void { self.release() }
}

impl<T> Drop for Weak<T> {
    func drop(self): void { self.release() }
}

impl<T> Clone for Weak<T> {
    func clone(self): Weak<T> { @unsafe { return Weak<T>::from_rc_ptr(self.ptr) } }
}
