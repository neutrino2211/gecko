package main

import std.collections.vec use { Vec }

declare external func puts(s: string): int32

external func main(): int32 {
    // Test Vec::new and push
    let v: Vec<int32> = Vec<int32>::new()

    if (!v.is_empty()) {
        return 1
    }

    v.push(10)
    v.push(20)
    v.push(30)

    if (v.length() != 3) {
        return 2
    }

    // Test get
    if (v.get(0) != 10) {
        return 3
    }
    if (v.get(1) != 20) {
        return 4
    }
    if (v.get(2) != 30) {
        return 5
    }

    // Test first and last
    if (v.first() != 10) {
        return 6
    }
    if (v.last() != 30) {
        return 7
    }

    // Test set
    v.set(1, 25)
    if (v.get(1) != 25) {
        return 8
    }

    // Test pop
    let popped: int32 = v.pop()
    if (popped != 30) {
        return 9
    }
    if (v.length() != 2) {
        return 10
    }

    // Test clear
    v.clear()
    if (!v.is_empty()) {
        return 11
    }

    // Test with more elements (triggers resize)
    let v2: Vec<int32> = Vec<int32>::new()
    v2.push(1)
    v2.push(2)
    v2.push(3)
    v2.push(4)
    v2.push(5)
    v2.push(6)

    if (v2.length() != 6) {
        return 12
    }

    let sum: int32 = 0
    sum = v2.get(0) + v2.get(1) + v2.get(2) + v2.get(3) + v2.get(4) + v2.get(5)
    if (sum != 21) {
        return 13
    }

    v.drop()
    v2.drop()

    puts("All vec tests passed!")
    return 0
}
