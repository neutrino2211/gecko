package rc

import std.core.traits use { Drop, Clone }
import std.option use { Option }
import std.unsafe use { NonNull }

import std.memory.rc_storage use { RcInner }

public class Rc<T> {
    let ptr: uint64

    func new(value: T): Rc<T> {
        @unsafe [
            inner: RcInner<T>* = @alloc(@size_of<RcInner<T>>(), @align_of<RcInner<T>>()) as RcInner<T>*
        ] with NonNull::handle(inner as void*) {
            inner.strong = 1
            inner.weak = 1
            inner.value = @move(value)
            let r: Rc<T>
            r.ptr = inner as uint64
            return r
        }
    }

    @unsafe
    func from_inner_checked(inner_ptr: uint64): Option<Rc<T>> {
        if (inner_ptr == 0) {
            return Option<Rc<T>>::none()
        }
        @unsafe {
            let inner: RcInner<T>* = inner_ptr as RcInner<T>*
            if (inner.strong == 0 || inner.weak == 0) {
                return Option<Rc<T>>::none()
            }
            inner.strong = inner.strong + 1
        }
        return Option<Rc<T>>::some(Rc<T> { ptr: inner_ptr })
    }

    func is_valid(self): bool {
        return self.ptr != 0
    }

    func strong_count(self): uint64 {
        if (self.ptr == 0) { return 0 }
        @unsafe {
            let inner: RcInner<T>* = self.ptr as RcInner<T>*
            return inner.strong
        }
    }

    func weak_count(self): uint64 {
        if (self.ptr == 0) { return 0 }
        @unsafe {
            let inner: RcInner<T>* = self.ptr as RcInner<T>*
            return inner.weak
        }
    }

    @unsafe
    func get(self): T {
        @unsafe {
            let inner: RcInner<T>* = self.ptr as RcInner<T>*
            return inner.value
        }
    }

    func clone(self): Rc<T> {
        if (self.ptr != 0) {
            @unsafe {
                let inner: RcInner<T>* = self.ptr as RcInner<T>*
                inner.strong = inner.strong + 1
            }
        }
        let r: Rc<T>
        r.ptr = self.ptr
        return r
    }

    func release(self): void {
        if (self.ptr == 0) { return }
        let address: uint64 = self.ptr
        self.ptr = 0
        @unsafe {
            let inner: RcInner<T>* = address as RcInner<T>*
            inner.strong = inner.strong - 1
            if (inner.strong != 0) { return }
            @drop_in_place(&inner.value)
            inner.weak = inner.weak - 1
            if (inner.weak == 0) {
                @free(inner as void*)
            }
        }
    }

    func drop(self): void {
        self.release()
    }

    func as_raw(self): uint64 {
        @unsafe {
            let inner: RcInner<T>* = self.ptr as RcInner<T>*
            return &inner.value as uint64
        }
    }

    func inner_ptr(self): uint64 {
        return self.ptr
    }
}

impl<T> Drop for Rc<T> {
    func drop(self): void {
        self.release()
    }
}

impl<T> Clone for Rc<T> {
    func clone(self): Rc<T> {
        if (self.ptr != 0) {
            @unsafe {
                let inner: RcInner<T>* = self.ptr as RcInner<T>*
                inner.strong = inner.strong + 1
            }
        }
        let r: Rc<T>
        r.ptr = self.ptr
        return r
    }
}
