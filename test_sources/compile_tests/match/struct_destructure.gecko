declare external variardic func printf(format: string): int32

class Point {
    let x: int32
    let y: int32
}

func classify_point(p: Point): int32 {
    return match p {
        Point { x = 0, y = 0 } => 1
        Point { x = 0, y = _ } => 2
        Point { x = _, y = 0 } => 3
        Point { x = _, y = _ } => 4
        default => 0
    }
}

external func main(): int32 {
    let origin: Point = Point { x: 0, y: 0 }
    let on_y: Point = Point { x: 0, y: 5 }
    let on_x: Point = Point { x: 3, y: 0 }
    let somewhere: Point = Point { x: 1, y: 2 }

    let r1: int32 = classify_point(origin)
    let r2: int32 = classify_point(on_y)
    let r3: int32 = classify_point(on_x)
    let r4: int32 = classify_point(somewhere)
    printf("r1=%d r2=%d r3=%d r4=%d\n", r1, r2, r3, r4)
    return r1
}
