// spec: spec/types.md, spec/functions.md, spec/classes.md, spec/modules.md, spec/control-flow.md

declare external variardic func printf(format: string): int32

enum Color {
    Red
    Green
    Blue
}

func classify_color(c: Color): int32 {
    return match c {
        Color.Red => 1
        Color.Green => 2
        Color.Blue => 3
        default => 0
    }
}

external func main(): int32 {
    let r1: int32 = classify_color(Color.Red)
    let r2: int32 = classify_color(Color.Green)
    let r3: int32 = classify_color(Color.Blue)
    printf("r1=%d r2=%d r3=%d\n", r1, r2, r3)
    return r1
}
