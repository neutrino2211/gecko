// spec: spec/types.md, spec/functions.md, spec/modules.md, spec/control-flow.md

declare external variardic func printf(format: string): int32

external func main(): int32 {
    let a: int32 = 10
    let b: int32 = 20
    let adder: func(int32): int32 = fn(x: int32): int32 {
        return x + a + b
    }
    let result: int32 = adder(5)
    printf("Result: %d\n", result)
    return 0
}
